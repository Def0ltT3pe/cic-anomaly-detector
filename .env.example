# Скопируйте в .env и заполните. .env не коммитится.
# Ключ Gemini необязателен: без него работают детекция и статистика.
GEMINI_API_KEY=

# OpenAI-совместимый API (OpenAI, OpenRouter, DeepSeek, Ollama, LM Studio).
# Для локальной Ollama: OPENAI_BASE_URL=http://localhost:11434/v1, ключ не нужен.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# Claude (официальный SDK anthropic), DeepSeek, OpenRouter.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Свои варианты LLM (Ollama, LM Studio…): config/llm.json по образцу config/llm.example.json.
# LLM по умолчанию: id варианта (gemini, claude, openai, deepseek, openrouter…).
# LLM_PROVIDER=

# Необязательный пароль на веб-интерфейс.
APP_PASSWORD=

# Каталог модели: models (рабочая) или models_v2 (экспериментальная).
MODEL_DIR=models

# Ещё папки с моделями для выбора в интерфейсе (через ; на Windows, : на Linux).
# Ищутся подписанные модели не глубже двух уровней (serverA/model2).
# MODELS_ROOT=

# Путь к tshark, если его нет в PATH и в стандартной папке Wireshark.
# TSHARK=

# Свои адреса и подсети через запятую: из них инциденты не собираются.
# TRUSTED_IPS=

# 0 — отключить проверку подписи и SHA-256 файлов модели.
VERIFY_MODEL_CHECKSUMS=1

# Пользователи и аудит (по умолчанию — относительные пути в проекте).
# USERS_FILE=config/users.json
# AUDIT_LOG=audit/audit.jsonl
# AUDIT_ENABLED=1

# Публикация порта: 0.0.0.0 — по сети, 127.0.0.1 — только локально.
APP_BIND=0.0.0.0
APP_PORT=8501
